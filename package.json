{
  "name": "wanderways-travel-booking-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WanderWays Travel online tour booking platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "lint": "eslint client/src server/src server/scripts server/test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
